# Copier ce fichier en .env (ignoré par git) et changer les valeurs.
# Lettres et chiffres uniquement (le mot de passe est injecté dans des fichiers de config).
# Mot de passe du superutilisateur postgres de la base source (registre interne)
SOURCE_DB_PASSWORD=change-me
# Mot de passe du superutilisateur postgres de la base cible (catalogue public)
TARGET_DB_PASSWORD=change-me-too
